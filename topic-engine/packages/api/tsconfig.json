{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "../..",
    "paths": {
      "@topic-engine/core":    ["packages/core/src/index"],
      "@topic-engine/db":      ["packages/db/src/index"],
      "@topic-engine/memory":  ["packages/memory/src/index"],
      "@topic-engine/workers": ["packages/workers/src/index"]
    }
  },
  "include": [
    "src/**/*",
    "../core/src/**/*",
    "../db/src/**/*",
    "../memory/src/**/*",
    "../workers/src/**/*"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
