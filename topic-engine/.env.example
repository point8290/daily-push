# ─── Topic Engine — environment template ──────────────────────────────────────
# Copy this file to .env and fill in your values for local development.
# Never commit .env with real API keys.
#
#   cp .env.example .env

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── LLM providers ─────────────────────────────────────────────────────────────
# ANTHROPIC required: default decomposition, critique, and scoring provider.
# OPENAI required:    L2 semantic memory uses text-embedding-3-small.
# GOOGLE optional:    only if routing any role to google/gemini-*.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama base URL (optional — for local models, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ── Per-role LLM overrides (optional) ────────────────────────────────────────
# Override provider/model for any pipeline role via env vars.
# Format: TE_{ROLE}_PROVIDER and TE_{ROLE}_MODEL
# Roles: DECOMPOSITION | CRITIQUE | PATCH | CLASSIFICATION | ANSWER_EVAL | RESOURCE_SCORING
# Providers: anthropic | openai | ollama | google
#
# Examples:
# TE_DECOMPOSITION_PROVIDER=anthropic
# TE_DECOMPOSITION_MODEL=claude-sonnet-4-6
# TE_RESOURCE_SCORING_PROVIDER=ollama
# TE_RESOURCE_SCORING_MODEL=qwen2.5:3b
# TE_RESOURCE_SCORING_BASE_URL=http://8.229.30.148:11434

# ── Resource discovery (optional) ─────────────────────────────────────────────
# If unset, resource:discovery uses Wikipedia/MDN/arXiv (no key required).
# Set both to use Google Custom Search (higher quality, broader coverage).
# Create a CSE at https://programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# YouTube Data API v3 (optional) — adds 1-2 video results per concept node.
# Get key: https://console.cloud.google.com  →  YouTube Data API v3
# Free quota: 10,000 units/day; each search costs 100 units.
YOUTUBE_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the dev Docker container started by `make dev-infra-up`.
DATABASE_URL=postgresql://topic_engine:topic_engine@localhost:5433/topic_engine_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API server ────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowed origins, or * for open CORS (dev only)
CORS_ORIGIN=*
