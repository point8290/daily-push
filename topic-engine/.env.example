# Copy to .env and fill in your keys

# Anthropic (required for default config)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional — only needed if routing any role to OpenAI)
OPENAI_API_KEY=sk-...

# Google (optional)
GOOGLE_API_KEY=...

# Ollama (optional — for local models, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
