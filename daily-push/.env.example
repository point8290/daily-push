# PostgreSQL
POSTGRES_URL=postgresql://daily_push_user:daily_push_pass@localhost:5434/daily_push_v2

# MongoDB
MONGO_URL=mongodb://localhost:27018/daily_push_v2

# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# LLM routing — controls all LLM calls (intake, understanding check, decomposition)
# LLM_PROVIDER: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Model name — must match the chosen provider
#   anthropic: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
#   openai:    gpt-4o | gpt-4o-mini | o1-mini
#   ollama:    qwen2.5:3b | llama3.2 | mistral | etc.
LLM_MODEL=claude-sonnet-4-6
# Base URL — required for ollama, ignored for anthropic/openai
#   ollama example: http://8.229.30.148:11434
LLM_BASE_URL=
# Optional internal cost estimation for margin tracking
# Enter provider/model-specific blended rates per 1K tokens if you want estimated cost summaries.
LLM_INPUT_COST_PER_1K_USD=0
LLM_OUTPUT_COST_PER_1K_USD=0

# Email (Resend - https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=daily-push@yourdomain.com

# JWT
JWT_SECRET=your-secret-minimum-32-chars

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
JSON_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=12
EVENT_RATE_LIMIT_WINDOW_MS=60000
EVENT_RATE_LIMIT_MAX=180
# Comma-separated emails allowed to access internal product/AI metrics.
OPERATOR_EMAILS=

# Topic Engine
TOPIC_ENGINE_URL=http://localhost:3000
TOPIC_ENGINE_DECOMPOSE_CONCURRENCY=2
TOPIC_ENGINE_TIMEOUT_MS=300000
TOPIC_ENGINE_MAX_ATTEMPTS=2
TOPIC_ENGINE_RETRY_BASE_DELAY_MS=5000

# Billing
# BILLING_PROVIDER: manual | stripe
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_SPRINT_MONTH=
STRIPE_PRICE_SPRINT_YEAR=

# Weekly summary scheduler
# Set to false to disable background weekly summary delivery
WEEKLY_SUMMARY_SCHEDULER_ENABLED=true
# How often the backend should scan for due weekly summaries
WEEKLY_SUMMARY_CHECK_INTERVAL_MS=3600000
# Fallback local send time when the user has not set a digest time
WEEKLY_SUMMARY_DEFAULT_DIGEST_TIME=08:00

# Career gap report
# Set both to true if you want users to add GitHub/repo evidence to career gap reports.
GAP_REPORT_REPO_EVIDENCE_ENABLED=false
VITE_GAP_REPORT_REPO_EVIDENCE_ENABLED=false

# Role Market Intelligence
# Keep these disabled until the corresponding implementation slice has passed QA.
# Launch preset after migrations 019-024 are applied:
# FEATURE_ROLE_MARKET_PUBLIC=true
# FEATURE_TARGET_ROLE_SAVE=true
# FEATURE_ROLE_READINESS_REPORT=true
# FEATURE_ROLE_MARKET_AI_SUMMARY=false
# Enables public role market catalog and recommendations.
FEATURE_ROLE_MARKET_PUBLIC=false
# Enables authenticated Target Role saving. Requires target-role persistence migration and entitlement config.
FEATURE_TARGET_ROLE_SAVE=false
# Enables authenticated Role Readiness reports. Requires readiness/evidence persistence migrations and entitlement config.
FEATURE_ROLE_READINESS_REPORT=false
# Enables LLM-written Role Market explanations on top of deterministic scoring.
FEATURE_ROLE_MARKET_AI_SUMMARY=false
# Active curated market dataset identifier.
ROLE_MARKET_SEED_VERSION=role-market-seed.v1
# Visible timestamp for user-facing market claims.
ROLE_MARKET_LAST_UPDATED=2026-05-18T00:00:00.000Z
# ROLE_MARKET_SOURCE_MODE: curated | hybrid | live
ROLE_MARKET_SOURCE_MODE=curated
# Public role recommendation rate limit.
ROLE_MARKET_RECOMMEND_RATE_LIMIT_WINDOW_MS=60000
ROLE_MARKET_RECOMMEND_RATE_LIMIT_MAX=20
