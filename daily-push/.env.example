# PostgreSQL
POSTGRES_URL=postgresql://daily_push_user:daily_push_pass@localhost:5434/daily_push_v2

# MongoDB
MONGO_URL=mongodb://localhost:27018/daily_push_v2

# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# LLM routing — controls all LLM calls (intake, understanding check, decomposition)
# LLM_PROVIDER: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Model name — must match the chosen provider
#   anthropic: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
#   openai:    gpt-4o | gpt-4o-mini | o1-mini
#   ollama:    qwen2.5:3b | llama3.2 | mistral | etc.
LLM_MODEL=claude-sonnet-4-6
# Base URL — required for ollama, ignored for anthropic/openai
#   ollama example: http://8.229.30.148:11434
LLM_BASE_URL=

# Email (Resend - https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=daily-push@yourdomain.com

# JWT
JWT_SECRET=your-secret-minimum-32-chars

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Topic Engine
TOPIC_ENGINE_URL=http://localhost:3000
