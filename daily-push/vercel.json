{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build --workspace=packages/shared && npm run build --workspace=packages/frontend",
  "outputDirectory": "packages/frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://daily-push-api.onrender.com/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
